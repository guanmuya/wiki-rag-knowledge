{
  "name": "wiki-rag-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "企业多知识库文档整理与智能问答系统（桌面版）",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "node scripts/dev.mjs",
    "build:web": "tsc -b && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/build.mjs --pack",
    "start": "electron .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "electron-updater": "^6.8.11",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
